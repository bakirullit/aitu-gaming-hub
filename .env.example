# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
# Optional Webhook configuration (if unset, bot runs in polling mode for local development)
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_webhook_secret_token

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aitu_gaming_hub

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379/0

# Minecraft Campus Server (RCON with strict <3.0s deadline budget)
MINECRAFT_HOST=127.0.0.1
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=your_rcon_password
MINECRAFT_RCON_TIMEOUT=3.0

# Helpdesk Support Settings
HELPDESK_ADMIN_CHAT_ID=-1001234567890
